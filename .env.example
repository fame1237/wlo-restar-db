# ค่านี้เป็น Public client configuration และจะปรากฏในไฟล์ frontend หลัง build
# ความปลอดภัยของข้อมูลต้องบังคับด้วย Row Level Security ใน Supabase
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
VITE_ADMIN_USERNAME=admin1234
VITE_ADMIN_EMAIL=admin1234@demondex.local

# ห้ามใส่ service_role key หรือ secret key ในไฟล์ที่ขึ้นต้นด้วย VITE_
